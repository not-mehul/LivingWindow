# Dependencies (should none ever be added). The bare entry also covers a
# symlink to a global install, which is how tools/ finds Playwright.
node_modules/
node_modules
# …and the lock that goes with them. The piece has no dependencies; the only
# thing package.json declares is Playwright, for the benches in tools/, and
# pinning a bench's dependency tree into the repo would be pinning the wrong
# thing entirely.
package-lock.json

# Editor / OS cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# Logs and local scratch
*.log
.cache/

# reference recordings, fetched by tools/reference.mjs — never committed
refaudio

# pictures taken by tools/shot.mjs — a bench output, not part of the piece
shots/
